# ============================================================
# ZERO-BUILDER — Environment Variables Configuration
# ============================================================

# Server Port (Default: 4173)
PORT=4173

# ------------------------------------------------------------
# LLM Provider API Keys
# ------------------------------------------------------------
# OpenAI (GPT-4o, GPT-4o-mini)
OPENAI_API_KEY=your_openai_api_key_here

# Google Gemini (Gemini 1.5 Pro / Flash, Gemini 2.0 Flash)
GEMINI_API_KEY=your_gemini_api_key_here

# Anthropic Claude (Claude 3.5 Sonnet, Claude 3 Opus)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Groq (Llama 3 70B, Mixtral)
GROQ_API_KEY=your_groq_api_key_here

# DeepSeek (DeepSeek-V3, DeepSeek-R1)
DEEPSEEK_API_KEY=your_deepseek_api_key_here

# Mistral AI
MISTRAL_API_KEY=your_mistral_api_key_here

# ------------------------------------------------------------
# Custom LLM Endpoint / Local Model (OpenAI-Compatible)
# ------------------------------------------------------------
# For Ollama (Local): http://localhost:11434/v1
# For OpenRouter: https://openrouter.ai/api/v1
# For LM Studio / vLLM / LocalAI: http://localhost:1234/v1
CUSTOM_LLM_BASE_URL=http://localhost:11434/v1
CUSTOM_LLM_MODEL_NAME=qwen2.5-coder
CUSTOM_LLM_API_KEY=

# ------------------------------------------------------------
# Integration & Deployment Keys
# ------------------------------------------------------------
# Tavily Search API Key (Web Research Agent)
TAVILY_API_KEY=your_tavily_api_key_here

# Netlify Personal Access Token (Direct Site Deployments)
NETLIFY_AUTH_TOKEN=your_netlify_token_here

# Vercel Token
VERCEL_TOKEN=your_vercel_token_here
